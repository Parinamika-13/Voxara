# =====================================================================
# SWARAJYA AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Knowledge Base Path (relative to project root)
KNOWLEDGE_BASE_DIR=../data/knowledge

# Gnani AI Configuration (Prisma STT & Timbre TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.gnani.ai
GNANI_PRISMA_ENDPOINT=/stt
GNANI_TIMBRE_ENDPOINT=/tts
GNANI_PRISMA_MODEL=default
GNANI_TIMBRE_MODEL=default
GNANI_LANGUAGE=en-IN

# Optional Reasoning / LLM Service
LLM_PROVIDER=
LLM_API_KEY=
